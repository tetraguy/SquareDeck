<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The windows10 target adds the WinRT APIs used for media, Wi-Fi and Bluetooth. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>SquareDeck</AssemblyName>
    <RootNamespace>SquareDeck</RootNamespace>
    <Version>7.3.40</Version>
    <ApplicationIcon>Assets\SquareDeck.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The built-in web browser. Visual Studio downloads this the first time the solution is built. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2478.35" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interface sound packs, copied next to the program. Each sub-folder is one pack. -->
    <None Update="SoundPacks\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Music\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Backgrounds\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Wallpapers\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Skins\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="VacuumTube\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="StoreLogos\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Streaming service logos for the Multimedia page: Streaming\<id>.png -->
    <None Update="Streaming\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Tools\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="CloudLogos\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Recomp Zone's emblem for its opening animation -->
    <None Update="RecompZone\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Retro Lounge's emblem (logo.svg is its source) -->
    <None Update="RetroLounge\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Devices\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Button pictures for the hints: Glyphs\<look>\<controller or keyboard>\<button>.png -->
    <None Update="Glyphs\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Game Bar widget package (Widget\README.md), when one has been built with Visual Studio's "Create App
       Packages": copied into the Widget folder next to SquareDeck, where SquareDeck installs it from. The installer
       puts the same files there. -->
  <ItemGroup Condition="Exists('..\Widget\SquareDeck.Widget\AppPackages')">
    <None Include="..\Widget\SquareDeck.Widget\AppPackages\**\*.msix;..\Widget\SquareDeck.Widget\AppPackages\**\*.msixbundle;..\Widget\SquareDeck.Widget\AppPackages\**\*.cer;..\Widget\SquareDeck.Widget\AppPackages\**\*.appx"
          Exclude="..\Widget\SquareDeck.Widget\AppPackages\**\TelemetryDependencies\**"
          Link="Widget\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Xbox mode home app (Services/HomeApp.cs): the package manifest and capability file go next to SquareDeck.exe,
         because Windows registers that folder as the package. The logos and public folder go in HomeApp\. -->
    <None Update="HomeApp\AppxManifest.xml" Link="AppxManifest.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="HomeApp\CustomCapability.SCCD" Link="CustomCapability.SCCD" CopyToOutputDirectory="PreserveNewest" />
    <None Update="HomeApp\Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="HomeApp\Public\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lean memory: the garbage collector compacts harder to keep the heap small (0-9; 0 = off). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
</Project>
