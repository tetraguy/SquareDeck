<Window x:Class="SquareDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SquareDeck" Width="1280" Height="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" FontFamily="Segoe UI">

    <!-- The whole UI is laid out at 1280x720 (1280x800 for 16:10 screens, set from code) and scaled to the screen. -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="RootGrid" Width="1280" Height="720" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="118"/>
                <RowDefinition Height="326"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <!-- Wallpaper chosen in Settings > Themes, softened so text stays readable -->
            <Rectangle x:Name="WallpaperLayer" Grid.RowSpan="7" Visibility="Collapsed" IsHitTestVisible="False"/>
            <!-- Moving background (a looping video), built in code -->
            <Grid x:Name="DynamicLayer" Grid.RowSpan="7" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True"/>
            <Rectangle x:Name="WallpaperScrim" Grid.RowSpan="7" Fill="{DynamicResource BgBrush}" Opacity="0.4"
                       Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- Blurred artwork of the highlighted game, faded in from code -->
            <Image x:Name="HeroImage" Grid.RowSpan="7" Stretch="UniformToFill" Opacity="0" Margin="-40"
                   IsHitTestVisible="False">
                <Image.Effect>
                    <BlurEffect x:Name="HeroBlur" Radius="28"/>
                </Image.Effect>
            </Image>
            <!-- Fades the artwork into the background where text and tiles sit (styles with full artwork) -->
            <Rectangle x:Name="HeroScrim" Grid.RowSpan="7" Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- Top bar: profile picture, current view, clock, connections, battery -->
            <Grid x:Name="TopBar" Grid.Row="0" Margin="62,34,62,0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="AvatarButton" Style="{StaticResource BareButton}" Width="70" Height="70"
                            Margin="-6" Click="Avatar_Click"/>
                    <TextBlock x:Name="ModeText" FontSize="22" Margin="18,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" FontSize="24" Foreground="{DynamicResource FgBrush}"
                               VerticalAlignment="Center"/>
                    <!-- Notification center, with a count of what's new -->
                    <Button x:Name="BellButton" Style="{StaticResource BareButton}" Margin="18,0,0,0"
                            VerticalAlignment="Center" Click="Bell_Click">
                        <Grid>
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="{DynamicResource FgBrush}"/>
                            <Border x:Name="BellBadge" MinWidth="16" Height="16" CornerRadius="8" Background="#E8453C"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0"
                                    Padding="4,0" Visibility="Collapsed">
                                <TextBlock x:Name="BellCount" FontSize="10" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="QuickButton" Style="{StaticResource BareButton}" Margin="6,0,0,0"
                            VerticalAlignment="Center" Click="Quick_Click">
                        <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{DynamicResource FgBrush}"/>
                    </Button>
                    <!-- Shown only while the radio is on; click to open its settings page -->
                    <Button x:Name="WifiButton" Style="{StaticResource BareButton}" Margin="6,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed" Click="Wifi_Click">
                        <TextBlock x:Name="WifiIcon" Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{DynamicResource FgBrush}"/>
                    </Button>
                    <Button x:Name="BluetoothButton" Style="{StaticResource BareButton}" Margin="6,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed" Click="Bluetooth_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                       Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                            <!-- Battery of connected Bluetooth headphones -->
                            <StackPanel x:Name="HeadphonePanel" Orientation="Horizontal" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                           Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HeadphoneText" FontSize="14" Margin="4,0,0,0"
                                           Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <!-- Battery of a wireless controller -->
                    <StackPanel x:Name="PadPanel" Orientation="Horizontal" Margin="14,0,0,0"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PadText" FontSize="14" Margin="6,0,0,0"
                                   Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Battery level; click for details -->
                    <Button x:Name="BatteryButton" Style="{StaticResource BareButton}" Margin="10,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed" Click="Battery_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BatteryText" FontSize="16" Foreground="{DynamicResource FgBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- Level, and a charging bolt while plugged in; set from code -->
                            <TextBlock x:Name="BatteryIcon" Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Game row -->
            <ListBox x:Name="GameList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                     Focusable="False" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     SelectionChanged="GameList_SelectionChanged"
                     PreviewMouseWheel="GameList_PreviewMouseWheel">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Margin="86,0"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Tile_MouseDown"/>
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Tile_MouseUp"/>
                        <EventSetter Event="PreviewMouseRightButtonUp" Handler="Tile_RightClick"/>
                        <EventSetter Event="PreviewTouchDown" Handler="Tile_TouchDown"/>
                        <EventSetter Event="PreviewTouchUp" Handler="Tile_TouchUp"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <!-- Width comes from the item (270, or 640 for "Continue where you left off") -->
                                    <Grid Width="{Binding TileWidth}" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48"/>
                                            <RowDefinition Height="270"/>
                                        </Grid.RowDefinitions>

                                        <!-- Title sits above the selected tile; Canvas lets it overflow sideways -->
                                        <Canvas x:Name="TitleHost" Visibility="Hidden" Opacity="{DynamicResource TileTitleOpacity}">
                                            <TextBlock Canvas.Left="8" Canvas.Top="6" Text="{Binding Name}" FontSize="26"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Canvas>

                                        <Border x:Name="Ring" Grid.Row="1" BorderThickness="{DynamicResource RingThickness}"
                                                Margin="{DynamicResource TileRingMargin}" Effect="{DynamicResource RingGlow}"
                                                CornerRadius="{DynamicResource RingCorner}" BorderBrush="Transparent"/>
                                        <Border Grid.Row="1" Margin="{DynamicResource TileInnerMargin}" Background="{DynamicResource TileBrush}"
                                                CornerRadius="{DynamicResource TileCorner}" Effect="{DynamicResource TileShadow}"
                                                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="{DynamicResource PanelStrokeThickness}">
                                            <Grid>
                                            <!-- Everything on the tile is clipped to this rounded shape -->
                                            <Border x:Name="CornerMask" Background="{DynamicResource TileMaskBrush}"
                                                    CornerRadius="{DynamicResource TileCorner}"/>
                                            <Grid>
                                                <Grid.OpacityMask>
                                                    <VisualBrush Visual="{Binding ElementName=CornerMask}"/>
                                                </Grid.OpacityMask>
                                                <TextBlock x:Name="Fallback" Text="{Binding Name}" Margin="18"
                                                           FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource SubtleBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- "Add app" and "Game library" tiles: an icon with the name under it -->
                                                <StackPanel x:Name="ActionFace" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" Visibility="Collapsed">
                                                    <TextBlock Text="{Binding TileGlyph}" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="64" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource SubtleBrush}"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                                                               Margin="0,16,0,0" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource SubtleBrush}"/>
                                                </StackPanel>
                                                <Image x:Name="CoverImage" Source="{Binding TileImage}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="{DynamicResource CoverScaling}"/>
                                                <!-- Animated cover: a silent looping clip, only on the highlighted tile -->
                                                <MediaElement x:Name="AnimatedFace" Visibility="Collapsed"
                                                              Source="{Binding AnimatedCover, NotifyOnTargetUpdated=True}"
                                                              LoadedBehavior="Manual" UnloadedBehavior="Close"
                                                              IsMuted="True" Stretch="UniformToFill"
                                                              Binding.TargetUpdated="Animated_SourceChanged"
                                                              MediaEnded="Animated_Ended" MediaFailed="Animated_Failed"/>
                                                <!-- Apps: the icon at its natural size on a gradient of its own colors -->
                                                <Border x:Name="IconFace" Background="{Binding TileBackground}"
                                                        Visibility="Collapsed">
                                                    <Image x:Name="IconImage" Source="{Binding Cover}" Width="124" Height="124"
                                                           Stretch="Uniform" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Effect>
                                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35"/>
                                                        </Image.Effect>
                                                    </Image>
                                                </Border>
                                                <!-- Experimental "Dusty tiles": dust on games not played for months -->
                                                <Image Source="{Binding DustImage}" Stretch="Fill" IsHitTestVisible="False"/>
                                                <!-- Experimental "Darken covers that aren't highlighted": dimmed and softened, cleared on the highlighted tile -->
                                                <Rectangle x:Name="CoverDim" Fill="{DynamicResource CoverDimBrush}" IsHitTestVisible="False"/>
                                                <Rectangle x:Name="CoverFade" Fill="{DynamicResource CoverFadeBrush}" IsHitTestVisible="False"/>
                                                <Border x:Name="UpdateBadge" Background="#2B7DE0" CornerRadius="3" Padding="8,3"
                                                        Margin="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="{Binding UpdateText}" FontSize="13" FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                                <!-- "Continue playing": wide artwork with the game and when it was last played -->
                                                <Grid x:Name="ContinueFace" Visibility="Collapsed">
                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0.25" EndPoint="0,1">
                                                                <GradientStop Color="#00000000" Offset="0"/>
                                                                <GradientStop Color="#E0000000" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,18">
                                                        <TextBlock Text="CONTINUE WHERE YOU LEFT OFF" FontSize="14" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentOnDarkBrush}"/>
                                                        <!-- The game's logo when SteamGridDB has one, else its name -->
                                                        <Image Source="{Binding ContinueLogo}" MaxHeight="80" MaxWidth="360" Stretch="Uniform"
                                                               HorizontalAlignment="Left" Margin="0,8,0,6" RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasContinueLogo}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                            <Image.Effect>
                                                                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.75"/>
                                                            </Image.Effect>
                                                        </Image>
                                                        <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,0"
                                                                   Foreground="White" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasContinueLogo}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="16" Foreground="#E0FFFFFF"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <!-- More about it: play time, achievements, status, rating, the last note -->
                                                        <TextBlock Text="{Binding ContinueDetail}" FontSize="14" Foreground="#B8FFFFFF" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasContinueDetail}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Grid Width="220" Height="5" HorizontalAlignment="Left" Margin="0,8,0,0">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasContinueProgress}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Border CornerRadius="2.5" Background="#40FFFFFF"/>
                                                            <Border CornerRadius="2.5" HorizontalAlignment="Left" Width="{Binding ContinueProgressWidth}"
                                                                    Background="{DynamicResource AccentOnDarkBrush}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                                <Border x:Name="RunBadge" Background="#2EB872" CornerRadius="3" Padding="8,3"
                                                        Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="RUNNING" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <!-- Xbox style: the name across the bottom of the selected tile -->
                                                <Border x:Name="NameOverlay" VerticalAlignment="Bottom" Padding="16,10" Visibility="Collapsed"
                                                        Background="#B0000000" Opacity="{DynamicResource TileNameOpacity}">
                                                    <TextBlock Text="{Binding Name}" FontSize="30" Foreground="White"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                                <Border x:Name="FavBadge" Width="34" Height="34" CornerRadius="17"
                                                        Background="#C0000000" Margin="8" HorizontalAlignment="Right"
                                                        VerticalAlignment="Top" Visibility="Collapsed">
                                                    <TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                               Foreground="#FF5A6E" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <!-- Accent while the games row has the focus; clear while a button or icon has it -->
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource RingActiveBrush}"/>
                                            <Setter TargetName="TitleHost" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="NameOverlay" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="CoverDim" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="CoverFade" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding HasAnimatedCover}" Value="True">
                                            <Setter TargetName="AnimatedFace" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter TargetName="RunBadge" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UsesIcon}" Value="True">
                                            <Setter TargetName="IconFace" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="CoverImage" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <!-- Icons that only exist small: drawn smaller instead of blurry -->
                                        <DataTrigger Binding="{Binding IconIsSmall}" Value="True">
                                            <Setter TargetName="IconImage" Property="Width" Value="84"/>
                                            <Setter TargetName="IconImage" Property="Height" Value="84"/>
                                        </DataTrigger>
                                        <!-- SteamGridDB icons fill the tile like a cover -->
                                        <DataTrigger Binding="{Binding IconFills}" Value="True">
                                            <Setter TargetName="IconImage" Property="Width" Value="NaN"/>
                                            <Setter TargetName="IconImage" Property="Height" Value="NaN"/>
                                            <Setter TargetName="IconImage" Property="Stretch" Value="UniformToFill"/>
                                            <Setter TargetName="IconImage" Property="Effect" Value="{x:Null}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter TargetName="UpdateBadge" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShowContinueFace}" Value="True">
                                            <Setter TargetName="ContinueFace" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Fallback" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsActionTile}" Value="True">
                                            <Setter TargetName="ActionFace" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Fallback" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Label over the games row in some styles ("Recent games") -->
            <TextBlock x:Name="RowHeader" Grid.Row="1" FontSize="18" FontWeight="SemiBold" Visibility="Collapsed"
                       Foreground="{DynamicResource FgBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>

            <!-- The highlighted game's name, large (PlayStation style) or beside its details (Steam style) -->
            <StackPanel x:Name="StylePanel" Grid.Row="2" Visibility="Collapsed" Margin="100,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <!-- Cinema: the game's logo instead of its name, when SteamGridDB has one -->
                <Image x:Name="StyleLogo" Visibility="Collapsed" MaxHeight="150" MaxWidth="560" Stretch="Uniform"
                       HorizontalAlignment="Left" Margin="0,0,0,6" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                    </Image.Effect>
                </Image>
                <TextBlock x:Name="StyleTitle" FontWeight="Bold" Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis"
                           MaxWidth="1000">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="StyleInfo" FontSize="16" Foreground="{DynamicResource SubtleBrush}" Margin="2,4,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="1000"/>
                <Border x:Name="PlayPill" CornerRadius="28" Padding="64,14" Margin="0,22,0,0" HorizontalAlignment="Left"
                        Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="PlayPill_Click"
                        Background="#33FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1">
                    <TextBlock Text="Play Game" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                </Border>
            </StackPanel>

            <TextBlock x:Name="EmptyText" Grid.Row="1" FontSize="24" TextAlignment="Center"
                       Foreground="{DynamicResource SubtleBrush}" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Info for the selected game -->
            <TextBlock x:Name="InfoText" Grid.Row="2" FontSize="16" Foreground="{DynamicResource SubtleBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Frosted style: the buttons sit together on one floating shelf -->
            <Border x:Name="ButtonDock" Grid.Row="3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="50" IsHitTestVisible="False"/>

            <!-- Round buttons -->
            <StackPanel x:Name="ButtonRow" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="HomeBtn" Style="{StaticResource RoundButton}" Content="&#xE80F;" Foreground="#0AB9C9"
                        ToolTip="Home" Click="Home_Click"/>
                <Button x:Name="FavBtn" Style="{StaticResource RoundButton}" Content="&#xEB52;" Foreground="#E8453C"
                        ToolTip="Favorites" Click="Favorites_Click"/>
                <Button x:Name="AppsBtn" Style="{StaticResource RoundButton}" Content="&#xE71D;" Foreground="#F2A100"
                        ToolTip="Apps" Click="Apps_Click"/>
                <Button x:Name="CapturesBtn" Style="{StaticResource RoundButton}" Content="&#xEB9F;" Foreground="#2B7DE0"
                        ToolTip="Captures" Click="Captures_Click"/>
                <Button x:Name="MusicBtn" Style="{StaticResource RoundButton}" Content="&#xE8D6;" Foreground="#2EB872"
                        ToolTip="Multimedia" Click="Music_Click"/>
                <Button x:Name="FriendsBtn" Style="{StaticResource RoundButton}" Content="&#xE716;" Foreground="#7B5BD6"
                        ToolTip="Friends" Click="Friends_Click"/>
                <Button x:Name="NewsBtn" Style="{StaticResource RoundButton}" Content="&#xE789;" Foreground="#E0662E"
                        ToolTip="News" Click="News_Click"/>
                <Button x:Name="BrowserBtn" Style="{StaticResource RoundButton}" Content="&#xE774;" Foreground="#3B82F6"
                        ToolTip="Web browser" Click="Browser_Click"/>
                <Button x:Name="ExplorerBtn" Style="{StaticResource RoundButton}" Content="&#xEC50;" Foreground="#0AA5B8"
                        ToolTip="Explorer" Click="Explorer_Click"/>
                <Button x:Name="StoresBtn" Style="{StaticResource RoundButton}" Content="&#xE7BF;" Foreground="{DynamicResource SubtleBrush}"
                        ToolTip="Stores" Click="Stores_Click"/>
                <Button x:Name="MyDeviceBtn" Style="{StaticResource RoundButton}" Content="&#xE7FC;" Foreground="#E23D7A"
                        ToolTip="My Device" Click="MyDevice_Click" Visibility="Collapsed"/>
                <Button x:Name="SettingsBtn" Style="{StaticResource RoundButton}" Content="&#xE713;" Foreground="{DynamicResource SubtleBrush}"
                        ToolTip="Settings" Click="Settings_Click"/>
                <Button x:Name="PowerBtn" Style="{StaticResource RoundButton}" Content="&#xE7E8;" Foreground="{DynamicResource SubtleBrush}"
                        ToolTip="Power" Click="Power_Click"/>
            </StackPanel>

            <!-- Name of the highlighted round button -->
            <TextBlock x:Name="ButtonLabel" Grid.Row="4" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>

            <!-- Footer -->
            <!-- Frosted style: the hints sit in a floating pill -->
            <Border x:Name="FooterPill" Grid.Row="6" Visibility="Collapsed" Margin="24,8,24,12" CornerRadius="26" IsHitTestVisible="False"/>

            <Grid x:Name="FooterGrid" Grid.Row="6" Margin="30,0">
                <Rectangle x:Name="FooterLine" Height="1" VerticalAlignment="Top" Fill="{DynamicResource FgBrush}"/>
                <StackPanel x:Name="FooterLeft" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                               Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>

                    <!-- What's playing, with play / pause; shown only while something is -->
                    <Button x:Name="MusicButton" Style="{StaticResource PanelButton}" FontSize="15" Focusable="False"
                            Margin="20,0,0,0" Visibility="Collapsed" Click="MusicOpen_Click">
                        <StackPanel Orientation="Horizontal">
                            <!-- The song's cover art, when the player shares it (the play/pause symbol otherwise) -->
                            <Border x:Name="MusicArt" Width="30" Height="30" CornerRadius="6" Margin="-8,0,10,0"
                                    VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="MusicGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="MusicText" MaxWidth="170" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- A streaming service kept open in the background: its logo and what's on; press to go back to it -->
                    <Button x:Name="StreamButton" Style="{StaticResource PanelButton}" FontSize="15" Focusable="False"
                            Margin="16,0,0,0" Visibility="Collapsed" Click="StreamOpen_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="StreamLogo" Width="56" Height="30" CornerRadius="7" Margin="-8,0,10,0" ClipToBounds="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="StreamText" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StreamCloseButton" Style="{StaticResource PanelButton}" FontSize="13" Focusable="False"
                            Margin="6,0,0,0" Visibility="Collapsed" Click="StreamClose_Click" ToolTip="Close the service">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Shown while a game is running -->
                    <StackPanel x:Name="RunningPanel" Orientation="Horizontal" Margin="24,0,0,0"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <Grid VerticalAlignment="Center">
                            <Ellipse x:Name="RunningDot" Width="10" Height="10" Fill="#2EB872" VerticalAlignment="Center"/>
                            <Border x:Name="RunningIcon" Width="30" Height="30" CornerRadius="6" Visibility="Collapsed"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="RunningText" FontSize="16" Margin="10,0,12,0"
                                   Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="StopButton" Style="{StaticResource PanelButton}" Content="Stop" FontSize="15"
                                Focusable="False" Click="StopRunning_Click"/>
                    </StackPanel>

                    <!-- Only used for progress and problems -->
                    <TextBlock x:Name="StatusText" FontSize="16" Margin="20,0,0,0" MaxWidth="170"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Button hints, built in code so they match every other page and follow the controller style -->
                <ContentControl x:Name="HomeHints" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,26,0"
                                Focusable="False" IsHitTestVisible="False"/>
            </Grid>

            <!-- Pages and dialogs (settings, details, captures…) are added here in code -->
            <Grid x:Name="ScreenLayer" Grid.RowSpan="7"/>

            <!-- Scan lines (Retro) or a faint grid (Neon), over the pages too -->
            <Rectangle x:Name="StyleOverlay" Grid.RowSpan="7" IsHitTestVisible="False" Visibility="Collapsed"/>

            <!-- Achievement pop-ups, added and removed in code -->
            <!-- Screen saver, shown after the home screen has been idle -->
            <Grid x:Name="SaverLayer" Grid.RowSpan="7" Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- Hit-testable only where a notification is (the grid itself has no background), so it can be tapped -->
            <Grid x:Name="ToastLayer" Grid.RowSpan="7"/>

            <!-- Startup animation, built and removed in code -->
            <Grid x:Name="IntroLayer" Grid.RowSpan="7" IsHitTestVisible="False"/>
        </Grid>
    </Viewbox>
</Window>
