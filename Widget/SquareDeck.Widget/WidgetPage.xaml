<Page
    x:Class="SquareDeck.Widget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">
    <!-- Everything inside is built in WidgetPage.xaml.cs. -->
    <Grid x:Name="Root">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0121519" Offset="0"/>
                <GradientStop Color="#F0171C23" Offset="0.6"/>
                <GradientStop Color="#F01A1A26" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
    </Grid>
</Page>
